<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ExamPlusProctor</AssemblyName>
    <RootNamespace>ExamPlus.Proctor</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\config\supabase.json" Link="config\supabase.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
