<Window x:Class="ExamPlus.Proctor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ExamPlus · Aplikasi Pengawas"
        Width="1120"
        Height="780"
        MinWidth="860"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#FFF1F6F3"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#FFE1EBE6"
                BorderThickness="0,0,0,1">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="EXAMPLUS  ·  APLIKASI PENGAWAS"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#FF11785F" />
                    <TextBlock x:Name="HeaderStatus"
                               Margin="0,4,0,0"
                               Text="Pemantauan ruang ujian"
                               FontSize="12"
                               Foreground="#FF70827B" />
                </StackPanel>
                <Button x:Name="LogoutButton"
                        Grid.Column="1"
                        Width="112"
                        Height="38"
                        Content="Keluar"
                        Click="LogoutButton_Click"
                        Visibility="Collapsed"
                        Background="White"
                        BorderBrush="#FFE1EBE6"
                        Foreground="#FF11785F"
                        FontWeight="SemiBold" />
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ContentControl x:Name="PageHost" Margin="28" />
        </ScrollViewer>
    </Grid>
</Window>
