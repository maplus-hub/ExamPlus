<Window x:Class="ExamPlus.Participant.SupervisorPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ExamPlus · Ujian dijeda"
        Width="480"
        Height="340"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="True"
        Background="#FFF4F6F5"
        WindowStartupLocation="CenterOwner"
        Closing="Window_Closing">
    <Border Margin="12"
            Padding="28"
            Background="White"
            BorderBrush="#FFE1EBE6"
            BorderThickness="1"
            CornerRadius="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="EXAMPLUS · UJIAN DIJEDA"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="#FF9B2936" />
            <TextBlock Margin="0,10,0,4"
                       Text="Perlu persetujuan pengawas"
                       FontSize="23"
                       FontWeight="Bold"
                       Foreground="#FF17352D" />
            <TextBlock x:Name="AlarmStatus"
                       Margin="0,0,0,18"
                       Text="Pelanggaran tercatat. Ujian tidak dapat dilanjutkan sebelum diverifikasi."
                       TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="#FF52645D" />
            <TextBlock Text="Kode rahasia pengawas"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#FF17352D" />
            <PasswordBox x:Name="ProctorCode"
                         Margin="0,6,0,0"
                         Height="44"
                         Padding="10,8"
                         FontSize="16"
                         MaxLength="128" />
            <TextBlock x:Name="StatusText"
                       MinHeight="36"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="#FF9B2936" />
            <Button x:Name="ResumeButton"
                    Height="44"
                    Margin="0,8,0,0"
                    Content="Verifikasi dan lanjutkan"
                    Click="ResumeButton_Click"
                    Background="#FF11785F"
                    Foreground="White"
                    FontSize="14"
                    FontWeight="SemiBold" />
        </StackPanel>
    </Border>
</Window>
